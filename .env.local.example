# ═══════════════════════════════════════════════════════════
# คัดลอกไฟล์นี้เป็น .env.local (โฟลเดอร์ follow-nurse ระดับเดียวกับ package.json)
# Supabase → Project Settings → API (โปรเจกต์ Follow_Nurse)
# ═══════════════════════════════════════════════════════════

# Project URL (คัดลอกทั้งบรรทัด)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# ใช้ตัวนี้เท่านั้น: "anon" + "public" (ไม่ใช่ service_role / secret)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh4eHh4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE2...

# ไม่จำเป็นสำหรับล็อกอิน (ใช้ตอน admin เพิ่มพนักงาน)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ข้อห้าม:
# - อย่าใส่เครื่องหมายคำพูด "..." รอบ key
# - อย่าเว้นวรรคหน้า/หลัง =
# - อย่าใส่ key ไม่ครบ (ต้องยาวมาก จบด้วย ...ตัวอักษร)
